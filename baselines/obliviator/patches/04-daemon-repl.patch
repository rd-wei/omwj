+#ifndef DISTRIBUTED_SGX_SORT_HOSTONLY
+static int process_input_path(oe_enclave_t *enclave, const char *path) {
+#else
+static int process_input_path(enum algorithm_type algorithm_type, const char *path) {
+#endif
+    size_t path_len = strlen(path);
+    if (path_len < 5) {
+        printf("ERROR: path too short (need .txt suffix): %s\n", path);
+        return -1;
+    }
+    input_file = fopen(path, "rb");
+    if (!input_file) {
+        printf("ERROR: cannot open input %s\n", path);
+        return -1;
+    }
+    char *output_file_path = calloc(path_len + 8, sizeof(*output_file_path));
+    memcpy(output_file_path, path, path_len - 4);
+    memcpy(output_file_path + path_len - 4, "_output.txt", 12);
+    output_file = fopen(output_file_path, "w");
+    free(output_file_path);
+    if (!output_file) {
+        printf("ERROR: cannot open output for %s\n", path);
+        fclose(input_file);
+        return -1;
+    }
+#ifndef DISTRIBUTED_SGX_SORT_HOSTONLY
+    return time_join(enclave);
+#else
+    return time_join(algorithm_type);
+#endif
+}
